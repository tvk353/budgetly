-- Session A: lower an expense while holding its row lock; a concurrent refund must re-check the cap.
-- DRAFT TEST ONLY; run interactively against the guarded disposable local DB.
\set ON_ERROR_STOP on
\set VERBOSITY verbose

DO $guard$
BEGIN
  IF current_setting('budgetly.disposable_test', true) IS DISTINCT FROM 'on' THEN
    RAISE EXCEPTION 'Disposable-test connection marker is required';
  END IF;
END;
$guard$;

BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub', '10000000-0000-4000-8000-000000000001', true);
SELECT id FROM public.transactions
 WHERE id = '60000000-0000-4000-8000-000000000003'::uuid
 FOR UPDATE;
UPDATE public.transactions SET amount = 700.00
 WHERE id = '60000000-0000-4000-8000-000000000003'::uuid;
\echo Session A changed the INR 500.00 expense to INR 700.00 and holds its lock.
\prompt 'Start expense_edit_session_b.psql, confirm it waits on a lock, then press Enter to commit A: ' barrier_ack
COMMIT;
