-- Session A: hold an ordinary expense lock with a partial refund.
-- DRAFT TEST ONLY; run interactively against the guarded disposable local DB.
\set ON_ERROR_STOP on
\set VERBOSITY verbose

DO $guard$
BEGIN
  IF current_setting('budgetly.disposable_test', true) IS DISTINCT FROM 'on' THEN
    RAISE EXCEPTION 'Disposable-test connection marker is required';
  END IF;
END;
$guard$;

BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub', '10000000-0000-4000-8000-000000000001', true);
SELECT id FROM public.transactions
 WHERE id = '60000000-0000-4000-8000-000000000002'::uuid
 FOR UPDATE;
INSERT INTO public.transactions
  (id, workspace_id, category_id, type, amount, transaction_date, linked_expense_id)
VALUES
  ('80000000-0000-4000-8000-000000000001'::uuid,
   '20000000-0000-4000-8000-000000000001'::uuid,
   '40000000-0000-4000-8000-000000000004'::uuid,
   'refund', 600.00, (now() at time zone 'Asia/Kolkata')::date,
   '60000000-0000-4000-8000-000000000002'::uuid);
\echo Session A has inserted INR 600.00 and holds the expense lock.
\prompt 'Start session B, confirm it waits on a lock, then press Enter to commit A: ' barrier_ack
COMMIT;
