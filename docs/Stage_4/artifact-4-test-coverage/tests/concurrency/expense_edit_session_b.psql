-- Session B: the INR 600.00 refund must block, then fail against the edited INR 700.00 expense plus INR 200.00 already refunded.
-- DRAFT TEST ONLY; run interactively against the guarded disposable local DB.
\set ON_ERROR_STOP on
\set VERBOSITY verbose

DO $guard$
BEGIN
  IF current_setting('budgetly.disposable_test', true) IS DISTINCT FROM 'on' THEN
    RAISE EXCEPTION 'Disposable-test connection marker is required';
  END IF;
END;
$guard$;

BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub', '10000000-0000-4000-8000-000000000002', true);
INSERT INTO public.transactions
  (id, workspace_id, category_id, type, amount, transaction_date, linked_expense_id)
VALUES
  ('80000000-0000-4000-8000-000000000003'::uuid,
   '20000000-0000-4000-8000-000000000001'::uuid,
   '40000000-0000-4000-8000-000000000004'::uuid,
   'refund', 600.00, (now() at time zone 'Asia/Kolkata')::date,
   '60000000-0000-4000-8000-000000000003'::uuid);
COMMIT;
