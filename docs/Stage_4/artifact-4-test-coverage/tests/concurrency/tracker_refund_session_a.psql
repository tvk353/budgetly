-- Session A: accept a partial tracker refund while holding the tracker expense lock.
-- DRAFT TEST ONLY; run interactively against the guarded disposable local DB.
\set ON_ERROR_STOP on
\set VERBOSITY verbose

DO $guard$
BEGIN
  IF current_setting('budgetly.disposable_test', true) IS DISTINCT FROM 'on' THEN
    RAISE EXCEPTION 'Disposable-test connection marker is required';
  END IF;
END;
$guard$;

BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub', '10000000-0000-4000-8000-000000000001', true);
INSERT INTO public.tracker_transactions
  (id, workspace_id, tracker_id, category_id, type, amount, transaction_date, linked_expense_id)
VALUES
  ('82000000-0000-4000-8000-000000000001'::uuid,
   '20000000-0000-4000-8000-000000000001'::uuid,
   '63000000-0000-4000-8000-000000000001'::uuid,
   '40000000-0000-4000-8000-000000000005'::uuid,
   'refund', 600.00, (now() at time zone 'Asia/Kolkata')::date,
   '62000000-0000-4000-8000-000000000006'::uuid);
\echo Session A inserted INR 600.00 and holds the tracker-expense lock.
\prompt 'Start tracker_refund_session_b.psql, confirm it waits on a lock, then press Enter to commit A: ' barrier_ack
COMMIT;
