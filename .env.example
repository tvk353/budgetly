# Local development only. Copy to .env.local after starting Supabase.
# Copy the publishable key from `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000

# Do not put secret/service-role keys in NEXT_PUBLIC_* variables.
# Server-only: local secret key from `pnpm exec supabase status`.
SUPABASE_SECRET_KEY=
# Generate a random value of at least 32 characters; shared across app instances.
AUTH_RATE_LIMIT_SECRET=
